{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:check": "node --experimental-strip-types scripts/build/check.ts",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:browser": "playwright test",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "oxfmt",
    "balance": "node --experimental-strip-types scripts/balance/main.ts",
    "balance:check": "node --experimental-strip-types scripts/balance/check.ts",
    "shots:compare": "node --experimental-strip-types scripts/shots/compare.ts",
    "figures": "node --experimental-strip-types scripts/figures.ts",
    "perf:boot": "node --experimental-strip-types scripts/perf/boot.ts",
    "backdrop": "node --experimental-strip-types scripts/backdrop.ts"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "three": "^0.185.1",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
