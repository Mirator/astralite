# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
game/test-results/
game/playwright-report/
game/blob-report/
game/.playwright/

# build output
.next/
.vinext/
out/
dist/
.wrangler/

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
# per-machine Claude Code settings, permissions and session state: local to whoever
# is working here, not to the project
.claude/

# deployment and generated files
.vercel
next-env.d.ts
outputs/
work/

# release archives regenerated by the build
*.tar.gz

# TypeScript incremental build state
*.tsbuildinfo

# playtest screenshots: the dev scripts in output/ recapture these on demand and
# they dwarf the source; the replay JSON and scripts there stay tracked
output/**/*.png
output/**/*.jpg
output/**/*.jpeg
output/**/*.webp
output/**/*.gif

# Reference frames pulled from other games for side-by-side review. They are
# someone else's work, they are only here to be looked at, and they must not be
# redistributed from this repository. The video is also 54MB.
output/shots/reference/
output/**/*.mp4
# Which side of a blind comparison was ours. Committing it would let the next
# reviewer look the answer up instead of judging the images.
output/shots/*-key.json
output/shots/seq-*.json
output/shots/stability.txt
